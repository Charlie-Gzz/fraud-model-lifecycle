# Secrets: generated by `fml up`, never committed
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*

# Local tools and runtime state
.tools/
.run/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform.tfstate.lock.info
infra/**/terraform.tfvars
crash.log

# Generated data (regenerable from seeds)
data/
cache/
mlruns/
mlartifacts/
spark-warehouse/
*.parquet

# Video intermediates
assets/video/raw/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
